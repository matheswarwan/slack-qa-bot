{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "slack-qa-bot",
  "main": "src/worker.js",
  "compatibility_date": "2026-07-03",
  "workers_dev": true,
  "kv_namespaces": [{ "binding": "TASK_STATE", "id": "5e6833ddf0d6480083e64c4a3699434b" }],
  // One ReviewRunner per QA task runs Claude's first-pass review in the background.
  "durable_objects": { "bindings": [{ "name": "REVIEWS", "class_name": "ReviewRunner" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ReviewRunner"] }],
  // Secrets (wrangler secret put): SLACK_BOT_TOKEN, SLACK_SIGNING_SECRET,
  // GOOGLE_SA_CLIENT_EMAIL, GOOGLE_SA_PRIVATE_KEY, JEV_API_KEY (Jeff for email
  // tasks) and ANTHROPIC_API_KEY (Claude for journeys and automations). Each
  // review is off without its key.
  // Text variables are set in the dashboard and kept by `deploy --keep-vars`:
  // QA_TEMPLATES (JSON list of {"label", "templateId", optional "reviewer"}),
  // JEV_MODEL, JEV_BASE_URL and CLAUDE_MODEL (all optional).
  "vars": {},
  "env": {
    // `wrangler deploy --env staging` deploys a separate Worker for testing, so a
    // branch never replaces the live bot. It has no KV, so duplicate-click
    // protection is off there.
    "staging": {
      "name": "slack-qa-bot-staging",
      "vars": {},
      "durable_objects": { "bindings": [{ "name": "REVIEWS", "class_name": "ReviewRunner" }] }
    }
  }
}
